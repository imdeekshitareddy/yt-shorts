# ==============================================================================
# Faceless Shorts & Narrative Pipeline Configuration
# Copy this file to .env and configure your credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Dedicated Python binary for Kokoro TTS & Whisper (Windows / macOS / Linux)
# Default on Windows: C:\Users\<Username>\.faceless-shorts\venv\Scripts\python.exe
# Default on macOS/Linux: ~/.faceless-shorts/venv/bin/python
FACELESS_PYTHON=C:/Users/username/.faceless-shorts/venv/Scripts/python.exe

# Google Apps Script Web App API (Narrative Library Sheet)
# Deployed Web App URL that reads/updates narrative rows
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Shared secret token matching the script property in Apps Script
APPS_SCRIPT_TOKEN=your_secret_api_token_here

# YouTube Shorts Publishing (Google Cloud OAuth 2.0 Client Credentials)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
# OAuth refresh token with https://www.googleapis.com/auth/youtube.upload scope
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token

# Instagram Reels Publishing (Meta Graph API)
# Requires an Instagram Business/Creator Account connected to a Facebook Page
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_access_token
